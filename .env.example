# Copy to .env (never commit real values).

# --- server ---
# Port the Socket.IO server listens on (Render sets this automatically).
PORT=3001
# Comma-separated allowed browser origins for CORS (your Vercel URL in production).
# Wildcards are allowed in the host, e.g. https://*.vercel.app. Empty = allow any (dev).
CLIENT_ORIGIN=http://localhost:5173

# --- client (Vite, read at build time) ---
# URL of the game server. Leave empty in local dev to use the Vite proxy.
VITE_SERVER_URL=

# Optional: how long bots "think" before moving, in ms (default ~900).
BOT_DELAY_MS=

# Optional: pause after each deal before anyone acts, in ms (default 2600).
DEAL_PAUSE_MS=
